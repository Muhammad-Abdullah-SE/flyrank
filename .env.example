# FlyRank environment variables (copy to .env and fill in — never commit)
# All values are optional; the app runs on sensible defaults.

# Server
FLYRANK_HOST=127.0.0.1
FLYRANK_PORT=8000

# Database file (default: ./data/flyrank.db)
# FLYRANK_DB=./data/flyrank.db

# LLM integration (optional — without a key FlyRank uses its local summarizer)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Cache TTL for ranked deal lists (seconds)
# FLYRANK_CACHE_TTL=60